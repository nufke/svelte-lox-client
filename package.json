{
	"name": "svelte-lox-client",
	"version": "0.0.1",
	"main": "dist/LoxClient.js",
	"type": "module",
	"types": "./dist/LoxClient.d.ts",
	"svelte": "./dist/LoxClient.js",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "npm run prepack",
		"prepack": "svelte-kit sync && svelte-package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write '{src,tests}/**/*.{js,ts,svelte}'"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/LoxClient.d.ts",
			"svelte": "./dist/LoxClient.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/package": "^2.5.4",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^24.5.2",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"globals": "^16.4.0",
		"jiti": "^2.6.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.3.3",
		"publint": "^0.3.2",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.46.1",
		"vite": "^6.0.0"
	},
	"author": "Martin Barnasconi",
	"license": "MIT",
	"keywords": [
		"svelte, websocket"
	],
	"dependencies": {
		"vite-plugin-node-polyfills": "^0.24.0"
	}
}
